/*
  appcleaner CLI — 日本語。キーは韓国語の原文 ("usage" を除く)。
  日本語には単数・複数の区別がないため、個数の文言もこのファイルに置く (CLI.stringsdict は不要)。
*/

"App Cleaner 설치 파일" = "App Cleaner のインストーラ";
"usage" = "使い方: appcleaner <コマンド> [オプション]

コマンド:
  scan <App のパス|名前>        App と残存ファイルを検査するだけ (何も削除しない)
      --all                     残す項目もすべて表示
      --json                    JSON で出力
  remove <App のパス|名前>      デフォルトで選択された項目をゴミ箱/保留フォルダに移動
      --dry-run                 実際には移動せず、整理の計画だけを出力 (JSON)
      --yes                     確認せずに実行
      --reset-privacy           プライバシー権限の記録 (TCC) をリセット
  orphans                       削除済み App の孤立した残存ファイルをスキャン
      --min-confidence <high|medium|low>
      --include-dotfiles        隠し設定フォルダも含める (~/.ssh と ~/.gnupg は常に除外)
      --json
  orphans clean                 孤立した残存ファイルを整理 (デフォルト: 信頼度「高」かつユーザデータ以外)
      --dry-run | --yes | --json
      --include-medium          信頼度「中」の項目も含める
  packages                      パッケージマネージャ (npm・cargo・pipx・uv) でインストールした CLI ツールと同じ名前のデータ
      --manager <npm|cargo|pipx|uv>  マネージャを限定 (カンマ区切りで複数可)
      --json
  packages remove <名前|パス>…  インストールした項目 (パッケージフォルダ・実行ファイルのリンク) をゴミ箱に移動
      --with-data               同じ名前のデータも一緒に (別のインストールと共有しているものは除外)
      --manager <…> | --dry-run | --yes | --json
  packages caches               パッケージマネージャのダウンロードキャッシュ
      --manager <…> | --json
  packages caches clean         キャッシュを整理 (次回のインストール時に再ダウンロード)
      --manager <…> | --dry-run | --yes | --json
  history [--json]              削除履歴
  restore <セッション ID> [--yes]  セッションを復元
  version                       バージョン

共通オプション:
  --lang <ko|en|ja>             出力言語 (デフォルト: APPCLEANER_LANG → LC_ALL・LANG → システムの言語、それ以外は英語)
                                --json の出力は言語に関係なく同じ
  --demo                        (開発用) ダミーデータのエンジンを使用";

