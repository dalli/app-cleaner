/*
  appcleaner CLI — English. Keys are the Korean source strings (except "usage").
  Count phrases that need singular/plural forms are in CLI.stringsdict, not here.
*/

"usage" = "Usage: appcleaner <command> [options]

Commands:
  scan <app path|name>          Inspect an app and its leftovers only (nothing is removed)
      --all                     Also show items that are kept
      --json                    JSON output
  remove <app path|name>        Move the default selection to the Trash or holding folder
      --dry-run                 Print the cleanup plan without moving anything (JSON)
      --yes                     Proceed without confirmation
      --reset-privacy           Reset privacy permission records (TCC)
  orphans                       Scan for orphaned leftovers of apps already deleted
      --min-confidence <high|medium|low>
      --include-dotfiles        Include hidden settings folders (~/.ssh and ~/.gnupg are always excluded)
      --json
  orphans clean                 Clean up orphaned leftovers (default: high confidence, not user data)
      --dry-run | --yes | --json
      --include-medium          Also include medium-confidence items
  packages                      CLI tools installed with a package manager (npm, cargo, pipx, uv) and data with the same name
      --manager <npm|cargo|pipx|uv>  Only these managers (comma-separated)
      --json
  packages remove <name|path>…  Move the installed files (package folder, executable links) to the Trash
      --with-data               Also data with the same name (except data shared with another installation)
      --manager <…> | --dry-run | --yes | --json
  packages caches               Package manager download caches
      --manager <…> | --json
  packages caches clean         Clean up the caches (downloaded again on the next install)
      --manager <…> | --dry-run | --yes | --json
  history [--json]              Cleanup history
  restore <session ID> [--yes]  Restore a session
  version                       Version

Common options:
  --lang <ko|en|ja>             Output language (default: APPCLEANER_LANG → LC_ALL/LANG → system language, otherwise English)
                                --json output doesn't depend on the language
  --demo                        (development) Use the fake data engine";

