"--lang 값이 필요합니다 (ko, en, ja)" = "--lang needs a value (ko, en, ja)";
"--lang은 ko, en, ja 중 하나입니다: %@" = "--lang must be one of ko, en, ja: %@";
"--min-confidence 값이 필요합니다" = "--min-confidence needs a value";
"--min-confidence는 high, medium, low 중 하나입니다" = "--min-confidence must be one of high, medium, low";
"검사할 앱을 지정하세요" = "Specify the app to inspect";
"제거할 앱을 지정하세요" = "Specify the app to remove";
"되돌릴 세션 ID(UUID)를 지정하세요 — `appcleaner history`로 확인" = "Specify the session ID (UUID) to restore — see `appcleaner history`";
"알 수 없는 명령: %@" = "Unknown command: %@";
"알 수 없는 옵션: %@" = "Unknown option: %@";
"알 수 없는 하위 명령: orphans %@" = "Unknown subcommand: orphans %@";
