    "dataPaths": ["~/.codex"],
    "reinstall": "npm install -g @openai/codex"
  },
  {
    "name": "codegraph",
    "executables": ["~/.local/bin/codegraph"],
    "versionFiles": [],
    "dataPaths": ["~/.codegraph"],
    "reinstall": "npm install -g @codegraph/cli"
  },
  {
    "name": "bun",
    "executables": ["~/.bun/bin/bun"],
    "versionFiles": [],
    "dataPaths": ["~/.bun"],
    "reinstall": "curl -fsSL https://bun.sh/install | bash"
  },
  {
    "name": "deno",
    "executables": ["~/.deno/bin/deno"],
    "versionFiles": [],
    "dataPaths": ["~/.deno"],
    "reinstall": "curl -fsSL https://deno.land/install.sh | sh"
  },
  {
    "name": "ollama",
    "executables": ["/usr/local/bin/ollama", "/opt/homebrew/bin/ollama", "~/.local/bin/ollama"],
    "versionFiles": [],
    "dataPaths": ["~/.ollama"],
    "reinstall": "https://ollama.com/download"
  },
  {
    "name": "cursor-agent",
