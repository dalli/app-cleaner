[
  {
    "name": "opencode",
    "executables": ["~/.opencode/bin/opencode", "~/.local/bin/opencode", "~/.config/opencode/bin/opencode"],
    "versionFiles": ["~/.opencode/VERSION", "~/.local/share/opencode/version"],
    "dataPaths": ["~/.opencode", "~/.config/opencode", "~/.local/share/opencode", "~/.cache/opencode"],
    "reinstall": "curl -fsSL https://opencode.ai/install | bash"
  },
  {
    "name": "omo",
    "executables": ["~/.local/bin/omo", "~/.omo/bin/omo"],
    "versionFiles": ["~/.omo/VERSION", "~/.omo/version"],
    "dataPaths": ["~/.omo"],
    "reinstall": null
  },
  {
    "name": "claude",
    "executables": ["~/.local/bin/claude", "~/.claude/local/claude"],
    "versionFiles": [],
    "dataPaths": ["~/.claude", "~/.local/share/claude", "~/.cache/claude", "~/Library/Caches/claude"],
    "reinstall": "claude update"
  },
  {
    "name": "codex",
    "executables": ["~/.local/bin/codex", "~/.codex/bin/codex"],
